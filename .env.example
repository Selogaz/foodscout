# Yandex Cloud: API-ключ сервисного аккаунта (роли ai.languageModels.user и search-api.webSearch.user) и каталог
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
# Модель AI Studio (короткое имя или gpt://<folder>/<model>/latest); пусто — deepseek-v4.1-flash
LLM_MODEL=
# Необязательно: другой OpenAI-совместимый endpoint вместо AI Studio и ключ к нему
LLM_BASE_URL=
LLM_API_KEY=
# Режим: auto — живой поиск, при сбое/без ключа демо; on — только демо; off — только живой (без фолбэка).
# Пусто: в продакшене on, в разработке auto. На Vercel живой поиск включается явно: DEMO_MODE=auto
DEMO_MODE=auto
# Предохранитель бюджета: живых поисков в сутки на инстанс (≈14–28,5 ₽ каждый); пусто — 15
LIVE_SEARCH_DAILY_LIMIT=
# Поисков в минуту с одного IP; пусто — 5
RATE_LIMIT_PER_MINUTE=
# Таймаут живого поиска, с (живой прогон ≈32–37 с; должен быть меньше maxDuration маршрута = 120); пусто — 100
LIVE_SEARCH_TIMEOUT_S=
# Время жизни кеша результатов, мин; пусто — 360
SEARCH_CACHE_TTL_MIN=
# Помощник решения (/api/advise, /api/draft-request): запросов в минуту с IP; пусто — 15
ASSIST_RATE_LIMIT_PER_MINUTE=
# Вызовов LLM помощником в сутки на инстанс (≈0,3–2,5 ₽ каждый); пусто — 100
ASSIST_DAILY_LLM_LIMIT=
# Таймаут одного вызова LLM помощником, с; после него — шаблонный ответ без модели; пусто — 25
ASSIST_TIMEOUT_S=
